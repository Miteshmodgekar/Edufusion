# ── Copy this file to .env and fill in your values ──────────────────────────

# Security (REQUIRED — generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-long-random-string

# ── MySQL Database (REQUIRED) ────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=cse_smart_db

# Flask environment
FLASK_ENV=development
FLASK_DEBUG=1

# ── Email (Flask-Mail) ───────────────────────────────────────────────────────
# Gmail setup: https://support.google.com/accounts/answer/185833
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_char_app_password
MAIL_DEFAULT_SENDER=CSE Smart System <your_email@gmail.com>

# Set to true to skip actual sending during development
MAIL_SUPPRESS_SEND=true

# ── PWA Push Notifications (VAPID) ──────────────────────────────────────────
# Generate keys by running: python utils/generate_vapid.py
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=admin@cse.edu

# ── AI Career Assistant (optional, FREE) ─────────────────────────────────────
# Get a free key at https://console.groq.com/keys (no credit card needed)
# Leave blank to disable the Career Assistant chat (students will see a
# "not configured" message instead).
GROQ_API_KEY=
CAREER_AI_MODEL=llama-3.3-70b-versatile
